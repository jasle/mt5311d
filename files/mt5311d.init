#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/mt5311d

start_service() {
	local enabled interface macaddr

	config_load mt5311d
	config_get_bool enabled main enabled 0
	config_get interface main interface
	config_get macaddr main macaddr

	[ "$enabled" = 1 ] || return 0

	if [ -z "$interface" ] || [ -z "$macaddr" ]; then
		echo "mt5311d: set mt5311d.main.interface and mt5311d.main.macaddr" >&2
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger mt5311d
}
