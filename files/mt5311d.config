config mt5311d 'main'
	# Start the daemon (also needs /etc/init.d/mt5311d enable)
	option enabled '0'
	# Network interface the SFP modem is attached to, e.g. sfp1
	option interface ''
	# MAC address of the modem (printed on its label)
	option macaddr ''
	# Seconds between background poll cycles
	option interval '30'
	# Seconds during which ubus calls get the last state instead of a new cycle
	option max_age '5'
